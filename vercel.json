{
  "services": {
    "django": {
      "root": ".",
      "entrypoint": "techgear_web/wsgi.py",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    },
    "api": {
      "root": "techgear_api/",
      "entrypoint": "src/main.py"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "django"
      }
    }
  ]
}
